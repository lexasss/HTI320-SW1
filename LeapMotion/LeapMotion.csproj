  </PropertyGroup>

  <ItemGroup>
    <Reference Include="LeapCSharp.NET4.5, Version=3.2.1.0, Culture=neutral, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\libs\managed\LeapCSharp.NET4.5.dll</HintPath>
    </Reference>
  </ItemGroup>
  
  <ItemGroup>
    <None Visible="false" Include="..\libs\x64\LeapC.dll">
